{
  "name": "web-mbd",
  "version": "0.0.0",
  "private": true,
  "description": "Flexible multibody dynamics in the browser.",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "taylor": "tsx src/cli/run-taylor.ts",
    "oracle:taylor": "tsx src/cli/run-oracle-taylor.ts",
    "inflate": "tsx src/cli/run-inflate.ts",
    "compare:inflate": "tsx src/cli/compare-inflate.ts",
    "diagnose:inflate-snap": "tsx src/cli/diagnose-inflate-snap.ts",
    "diagnose:kill-off": "tsx src/cli/diagnose-kill-off.ts",
    "diagnose:adyrel-period": "tsx src/cli/diagnose-adyrel-period.ts",
    "diagnose:adyrel-measurement": "tsx src/cli/diagnose-adyrel-measurement.ts",
    "diagnose:dt-convergence": "tsx src/cli/diagnose-dt-convergence.ts",
    "diagnose:slow-sphere": "tsx src/cli/diagnose-slow-sphere.ts",
    "diagnose:sphere-probe": "tsx src/cli/diagnose-sphere-probe.ts",
    "diagnose:stretch-measure": "tsx src/cli/diagnose-stretch-measure.ts",
    "diagnose:element-type": "tsx src/cli/diagnose-element-type.ts",
    "diagnose:stretch-diagnostics": "tsx src/cli/diagnose-stretch-diagnostics.ts",
    "diagnose:per-step-energy": "tsx src/cli/diagnose-per-step-energy.ts",
    "diagnose:deck-node-output": "tsx src/cli/diagnose-deck-node-output.ts",
    "diagnose:deck-quad-averaged": "tsx src/cli/diagnose-deck-quad-averaged.ts",
    "diagnose:deck-energy-split": "tsx src/cli/diagnose-deck-energy-split.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "eslint": "^10.10.0",
    "tsx": "^4.19.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "koffi": "^3.2.1"
  }
}
